# Copie para .env se quiser alterar as portas locais.
PORT=3001
NODE_OPTIONS=--max-old-space-size=384
MAX_ROOM_PARTICIPANTS=50
MAX_ROOMS=1000
# Token exclusivo dos adaptadores REST/MCP; nunca enviar ao navegador.
NAVIGATOR_ADAPTER_TOKEN=replace-with-at-least-32-random-characters
# Em producao, use a origem HTTPS exata do cliente. CLIENT_ORIGIN=* e rejeitado com NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
# Links opcionais publicados pelo administrador. Sem eles, o cliente oferece PWA/Expo Go.
APP_ANDROID_URL=
APP_IOS_URL=
EXPO_GO_URL=
# Chave mantida somente no servidor para o assistente conversacional Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VITE_SERVER_URL=http://localhost:3001
# Preencha depois de publicar os artefatos nativos; ficam visíveis no cliente web.
VITE_ANDROID_APK_URL=
VITE_IOS_TESTFLIGHT_URL=
# PEMs do servidor; no Render, use \n literal para que cada linha seja reconstruida.
EMERGENCY_PUBLIC_KEY_PEM=
EMERGENCY_PRIVATE_KEY_PEM=
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=MapParty/1.0 (configure-um-contato-em-producao)
GEOAPIFY_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=MapParty/1.0 (configure-um-contato-em-producao)
